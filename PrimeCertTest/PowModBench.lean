import PrimeCert.PowMod

/-! # Benchmark: pow-mod by pure reflection (B) vs. partial-in-elaborator (A)

`PrimeCert.PowMod` already provides **approach B** (pure reflection): the tactic `prove_pow_mod`
computes `a ^ b % n` in the elaborator with `powModTR'` and emits a single proof discharged by
the kernel reducing `powModTR` via `eagerReduce`.

This file adds **approach A** (partial in the elaborator): `mkPowModAuxEq` recurses on the
exponent in `MetaM`, emitting a chain of small step lemmas each closed by a tiny `rfl`, so the
kernel checks ~(bits of `b`) small steps instead of one giant reduction. Exposed as the tactic
`prove_pow_mod_steps`.

The `#time`d examples at the bottom run both tactics at increasing exponent sizes (256, 1024,
2048 bits); on a pinned CI runner these give the fair, noiseless comparison, and indicate which
approach (or hybrid) can reach the ~3912-bit exponent of the commented-out 700-digit example.
Adapted from `b-mehta/mathlib4@large-prime:Mathlib/V2/PowMod.lean`.
-/

set_option linter.style.longLine false

open Nat

namespace PrimeCert

-- Step lemmas for approach A (about `powModAux` from `PrimeCert.PowMod`).

lemma powModAux_zero_eq {a c n m : ℕ} (hm : c % n = m) : powModAux a 0 c n = m := by
  simpa [powModAux]

lemma powModAux_one_eq {a c n m : ℕ} (hm : (a * c) % n = m) : powModAux a 1 c n = m := by
  simp_all [powModAux]

lemma powModAux_even_eq {a a' b b' c n m : ℕ}
    (ha' : a * a % n = a') (hb' : b' <<< 1 = b)
    (h : powModAux a' b' c n = m) :
    powModAux a b c n = m := by
  rw [← ha', powModAux, mul_mod] at h
  rw [Nat.shiftLeft_eq, mul_comm, pow_one] at hb'
  rw [← hb', powModAux, pow_mul, mul_mod, pow_two, pow_mod, h]

lemma powModAux_odd_eq {a a' b b' c c' n m : ℕ}
    (hb' : 2 * b' + 1 = b) (ha' : a * a % n = a') (hc' : a * c % n = c')
    (h : powModAux a' b' c' n = m) :
    powModAux a b c n = m := by
  rw [← ha', ← hc', powModAux, mul_mod, mod_mod] at h
  rw [← hb', powModAux, pow_succ, pow_mul, mul_assoc, mul_mod, pow_mod, pow_two, h]

lemma powMod_eq_steps (a : ℕ) {a' b n m : ℕ} (h : powModAux a' b 1 n = m) (ha : a % n = a') :
    powMod a b n = m := by
  rwa [powModAux, mul_one, ← ha, pow_mod, mod_mod, ← pow_mod] at h

namespace Tactic.powModSteps

open Lean Meta Elab Tactic

/-- Approach A: given `a, b, c, n`, recurse on the exponent in the elaborator, returning
`(m, mE, ⊢ powModAux a b c n = m)` as a chain of `powModAux_*_eq` steps. -/
partial def mkPowModAuxEq (a b c n : ℕ) (aE bE cE nE : Expr) : MetaM (ℕ × Expr × Expr) :=
  if b = 0 then do
    let m : ℕ := c % n
    let mE : Expr := mkNatLit m
    return (m, mE, mkApp5 (mkConst ``powModAux_zero_eq) aE cE nE mE (← mkEqRefl mE))
  else if b = 1 then do
    let m : ℕ := (a * c) % n
    let mE : Expr := mkNatLit m
    return (m, mE, mkApp5 (mkConst ``powModAux_one_eq) aE cE nE mE (← mkEqRefl mE))
  else if b % 2 = 0 then do
    let b' := b / 2
    let a' := a * a % n
    let a'E := mkNatLit a'
    let b'E := mkNatLit b'
    let (m, mE, eq) ← mkPowModAuxEq a' b' c n a'E b'E cE nE
    return (m, mE, mkApp10 (mkConst ``powModAux_even_eq) aE a'E bE b'E cE nE mE
      (← mkEqRefl a'E) (← mkEqRefl bE) eq)
  else do
    let a' := a * a % n
    let b' := b / 2
    let c' := a * c % n
    let a'E := mkNatLit a'
    let b'E := mkNatLit b'
    let c'E := mkNatLit c'
    let (m, mE, eq) ← mkPowModAuxEq a' b' c' n a'E b'E c'E nE
    return (m, mE, mkApp5 (mkApp7 (mkConst ``powModAux_odd_eq) aE a'E bE b'E cE c'E nE)
      mE (← mkEqRefl bE) (← mkEqRefl a'E) (← mkEqRefl c'E) eq)

/-- Given `a, b, n`, return `(m, ⊢ powMod a b n = m)` via approach A. -/
def mkPowModEq (a b n : ℕ) (aE bE nE : Expr) : MetaM (ℕ × Expr × Expr) := do
  let a' := a % n
  let a'E := mkNatLit a'
  let (m, mE, eq) ← mkPowModAuxEq a' b 1 n a'E bE (mkNatLit 1) nE
  return (m, mE, ← mkAppM ``powMod_eq_steps #[aE, eq, ← mkEqRefl a'E])

def prove_pow_mod_steps_tac (g : MVarId) : MetaM Unit := do
  let t : Expr ← g.getType
  match_expr t with
  | Eq ty lhsE rhsE =>
    unless (← whnfR ty).isConstOf ``Nat do throwError "not an equality of naturals"
    let some rhs := rhsE.nat? | throwError "rhs is not a numeral"
    let some (aE, bE, nE) := lhsE.app3? ``powMod | throwError "lhs is not a pow-mod"
    let some a := aE.nat? | throwError "base is not a numeral"
    let some b := bE.nat? | throwError "exponent is not a numeral"
    let some n := nE.nat? | throwError "modulus is not a numeral"
    let (m', _, eq) ← mkPowModEq a b n aE bE nE
    unless m' = rhs do throwError "attempted to prove {a} ^ {b} % {n} = {rhs} but it's {m'}"
    g.assign eq
  | _ => throwError "not an accepted equality of pow-mod"

/-- Approach A tactic: proves `powMod a b n = m` by building a step chain in the elaborator. -/
elab "prove_pow_mod_steps" : tactic => liftMetaFinishingTactic prove_pow_mod_steps_tac

end Tactic.powModSteps

/-! ## Benchmarks

Each pair proves the same fact once with `prove_pow_mod` (B, reflection) and once with
`prove_pow_mod_steps` (A, elaborator steps). `#time` reports wall-clock; on a pinned CI runner
compare the two across sizes. Results `r = 2^e mod n` are exact by construction.
-/

open Tactic.powMod Tactic.powModSteps

-- 256-bit exponent
set_option maxRecDepth 1000 in
#time example : powMod 2 115792089237316195423570985008687907853269984665640564039457584007913129639934 115792089237316195423570985008687907853269984665640564039457584007913129639935 = 28948022309329048855892746252171976963317496166410141009864396001978282409984 := by prove_pow_mod
set_option maxRecDepth 1000 in
#time example : powMod 2 115792089237316195423570985008687907853269984665640564039457584007913129639934 115792089237316195423570985008687907853269984665640564039457584007913129639935 = 28948022309329048855892746252171976963317496166410141009864396001978282409984 := by prove_pow_mod_steps

-- 1024-bit exponent
set_option maxRecDepth 3000 in
#time example : powMod 2   =  := by prove_pow_mod
set_option maxRecDepth 3000 in
#time example : powMod 2   =  := by prove_pow_mod_steps

-- 2048-bit exponent
set_option maxRecDepth 6000 in
#time example : powMod 2   =  := by prove_pow_mod
set_option maxRecDepth 6000 in
#time example : powMod 2   =  := by prove_pow_mod_steps

end PrimeCert
