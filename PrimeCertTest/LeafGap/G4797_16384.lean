module

public meta import PrimeCert.Meta.QuickRfl
public import PrimeCert.GapFold

/-! # 2 special leaves at 16384 positions, walked by gaps

The first 4797 primes are sieved out of the interval and the survivors are walked
by the gaps between them, so the walk visits the survivors rather than every
position. The sibling files under LeafProbe answer the same leaves by folding over
every position; comparing the two says what the width costs and what the
survivors cost.

Nothing here is proved to be a leaf of anything; the file is for timing.
-/

set_option linter.style.longLine false

namespace PrimeCert.LeafGap.G4797_16384

open PrimeCert

/-- 2371 survivors of 16384 positions from 335006560. -/
public theorem leaf_0 : Nat.beq (gapFoldPosK  4294967296  8 255  2371)  = true := by
  quickRfl

/-- 2363 survivors of 16384 positions from 335022944. -/
public theorem leaf_1 : Nat.beq (gapFoldPosK  4294967296  8 255  2363)  = true := by
  quickRfl

end PrimeCert.LeafGap.G4797_16384
