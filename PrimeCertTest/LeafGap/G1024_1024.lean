module

public meta import PrimeCert.Meta.QuickRfl
public import PrimeCert.GapFold

/-! # 2 special leaves at 1024 positions, walked by gaps

The first 1024 primes are sieved out of the interval and the survivors are walked
by the gaps between them, so the walk visits the survivors rather than every
position. The sibling files under LeafProbe answer the same leaves by folding over
every position; comparing the two says what the width costs and what the
survivors cost.

Nothing here is proved to be a leaf of anything; the file is for timing.
-/

set_option linter.style.longLine false

namespace PrimeCert.LeafGap.G1024_1024

open PrimeCert

/-- 183 survivors of 1024 positions from 334822240. -/
public theorem leaf_0 : Nat.beq (gapFoldPosK  4294967296  8 255  183)  = true := by
  quickRfl

/-- 200 survivors of 1024 positions from 334823264. -/
public theorem leaf_1 : Nat.beq (gapFoldPosK  4294967296  8 255  200)  = true := by
  quickRfl

end PrimeCert.LeafGap.G1024_1024
