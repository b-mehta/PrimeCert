module

public meta import PrimeCert.Meta.QuickRfl
public import PrimeCert.PrimeHarmonic

/-! # A whole segment summed by position and by gap

262144 wheel positions from position 333333334, whose numbers begin just above `10 ^ 9`, in 128
batches of 2048. Each batch appears twice: `pos_i` adds `10 ^ 20` divided by the number at each
position whose bit is set, walking all 2048; `gap_i` walks only the gaps between consecutive
primes, carrying in one number the window it rebuilds, the position it has reached and the total.
`tie_i` says the window it rebuilt is the batch's own window shifted up one place, which is what
makes a missing or invented gap impossible.

The two sets of checks are timed against each other; nothing here is proved to agree with
`sumB (recipAtW ...)` beyond the kernel settling both to the same total.
-/

namespace PrimeCert.GapSeg

open PrimeCert

/-- One number holding, from the bottom, the rebuilt window of 2049 bits, the position reached in
32 bits, and the total above that. -/
@[expose] public noncomputable def gapFoldK (G lo S c : ℕ) : ℕ :=
  c.rec (nat_lit 0) fun i st ↦
    Nat.add
      (Nat.lor (Nat.mod st (nat_lit ))
        (Nat.shiftLeft (nat_lit 1)
          (Nat.add (Nat.mod (Nat.div st (nat_lit )) (nat_lit 4294967296))
            (Nat.land (Nat.shiftRight G (Nat.mul (nat_lit 8) i)) (nat_lit 255)))))
      (Nat.mul (nat_lit )
        (Nat.add
          (Nat.add (Nat.mod (Nat.div st (nat_lit )) (nat_lit 4294967296))
            (Nat.land (Nat.shiftRight G (Nat.mul (nat_lit 8) i)) (nat_lit 255)))
          (Nat.mul (nat_lit 4294967296)
            (Nat.add (Nat.div st (nat_lit ))
              (Nat.div S
                (Sieve.valueK
                  (Nat.add lo
                    (Nat.add (Nat.mod (Nat.div st (nat_lit )) (nat_lit 4294967296))
                      (Nat.land (Nat.shiftRight G (Nat.mul (nat_lit 8) i))
                        (nat_lit 255))))))))))

set_option maxRecDepth 4000000 in
theorem pos_0 :
    Nat.beq (sumB (recipAtW (nat_lit ) (nat_lit 333333334) (nat_lit 100000000000000000000))
      (nat_lit 0) (nat_lit 2048) (nat_lit 1)) (nat_lit 30299903876190) = true := by quickRfl

set_option maxRecDepth 4000000 in
theorem gap_0 :
    Nat.beq (gapFoldK (nat_lit ) (nat_lit 333333333) (nat_lit 100000000000000000000) (nat_lit 303))
      (nat_lit ) = true := by quickRfl

theorem tie_0 :
    Nat.beq (Nat.mod (nat_lit ) (nat_lit ))
      (Nat.shiftLeft (nat_lit ) (nat_lit 1)) = true := by quickRfl

