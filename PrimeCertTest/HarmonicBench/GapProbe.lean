module

public meta import PrimeCert.Meta.QuickRfl
public import PrimeCert.PrimeHarmonic

/-! # A walk over every position against a walk over the gaps between survivors

One batch of 2048 wheel positions from position 333333334, whose numbers begin just above `10 ^ 9`, and
which holds 303 primes. `byPosition` adds `10 ^ 20` divided by the number at each of the 2048
positions whose bit is set, which is what a run does today. `byGap` walks the 303 gaps between
consecutive primes instead, carrying in one number the window it rebuilds, the position it has
reached and the total so far, so a wrong or missing gap changes the window it rebuilds.

`gapFoldK` is the walk over gaps: at each step it reads the next gap from the low bits of `G`,
adds it to the position, sets that bit of the rebuilt window, and adds the quotient there.
-/

namespace PrimeCert.GapProbe

open PrimeCert

/-- One number holding, from the bottom, the rebuilt window of `2048` bits, the position reached
in `32` bits, and the total above that. -/
@[expose] public noncomputable def gapFoldK (G lo S c : ℕ) : ℕ :=
  c.rec (nat_lit 0) fun i st ↦
    Nat.add
      (Nat.lor (Nat.mod st (nat_lit ))
        (Nat.shiftLeft (nat_lit 1)
          (Nat.add (Nat.mod (Nat.div st (nat_lit )) (nat_lit 4294967296))
            (Nat.land (Nat.shiftRight G (Nat.mul (nat_lit 8) i)) (nat_lit 255)))))
      (Nat.mul (nat_lit )
        (Nat.add
          (Nat.add (Nat.mod (Nat.div st (nat_lit )) (nat_lit 4294967296))
            (Nat.land (Nat.shiftRight G (Nat.mul (nat_lit 8) i)) (nat_lit 255)))
          (Nat.mul (nat_lit 4294967296)
            (Nat.add (Nat.div st (nat_lit ))
              (Nat.div S
                (Sieve.valueK
                  (Nat.add lo
                    (Nat.add (Nat.mod (Nat.div st (nat_lit )) (nat_lit 4294967296))
                      (Nat.land (Nat.shiftRight G (Nat.mul (nat_lit 8) i))
                        (nat_lit 255))))))))))

set_option maxRecDepth 4000000 in
theorem byPosition :
    Nat.beq (sumB (recipAtW (nat_lit ) (nat_lit 333333334) (nat_lit 100000000000000000000))
      (nat_lit 0) (nat_lit 2048) (nat_lit 1)) (nat_lit 30299903876190) = true := by quickRfl

set_option maxRecDepth 4000000 in
theorem byGap :
    Nat.beq (gapFoldK (nat_lit ) (nat_lit 333333333) (nat_lit 100000000000000000000) (nat_lit 303))
      (nat_lit ) = true := by quickRfl

end PrimeCert.GapProbe
